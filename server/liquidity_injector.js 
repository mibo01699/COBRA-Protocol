const ethers = require("ethers");
require("dotenv").config();

// واجهة برمجية مصغرة لمطابقة مجمع سيولة DEX Pi والمحفظة السيادية
const IPiDexPairABI = [
    "function getReserves() external view returns (uint112 reserve0, uint112 reserve1, uint32 blockTimestampLast)",
    "function swap(uint amount0Out, uint amount1Out, address to, bytes calldata data) external"
];

const BIGISH_YER_WALLET = process.env.BIGISH_YER_MAIN_WALLET; // محفظة الإطلاق الرسمية للمستودع
const DEX_PAIR_ADDRESS = process.env.PI_YER_DEX_PAIR;

/**
 * @notice فحص السيولة الأولية وسحب المقادير اللازمة لتأمين الحزم الدولية في ثانية واحدة
 * @param requiredYerSubUnits حجم التكلفة المطلوبة بالوحدات الفرعية لـ YER (بدقة 10 خانات)
 */
async function fetchInitialDexLiquidity(requiredYerSubUnits) {
    const provider = new ethers.JsonRpcProvider(process.env.PI_RPC_URL);
    const wallet = new ethers.Wallet(process.env.COBRA_PRIVATE_KEY, provider);
    const dexPairContract = new ethers.Contract(DEX_PAIR_ADDRESS, IPiDexPairABI, wallet);

    try {
        console.log(`[Cobra-Liquidity]: Querying live reserves from Pi/YER DEX Pool...`);
        const [reservePi, reserveYer] = await dexPairContract.getReserves();

        // 1. التحقق من عمق السيولة لمنع الانزلاق السعري في الأعداد الصحيحة (Strict BigInt)
        if (reserveYer === 0n || reservePi === 0n) {
            throw new Error("Cobra-Error: DEX Pool lacks initial liquidity bootstrap.");
        }

        // 2. معادلة المقاصة من مجمع السيولة الثابت (Constant Product: X * Y = K)
        // حساب كمية الـ Pi المطلوبة لمبادلتها وسحب مقدار الـ YER المطلوب لتغطية الـ eSIM
        const feeMultiplier = 997n; // 0.3% رسوم مجمع السيولة الافتراضية للـ DEX
        const numerator = reservePi * requiredYerSubUnits * 1000n;
        const denominator = (reserveYer - requiredYerSubUnits) * feeMultiplier;
        const requiredPiStroops = (numerator / denominator) + 1n;

        console.log(`[Cobra-Liquidity]: Atomic Match Found.`);
        console.log(`-> Required Pi: ${requiredPiStroops.toString()} Stroops`);
        console.log(`-> Target YER: ${requiredYerSubUnits.toString()} Sub-units`);

        return {
            success: true,
            requiredPiStroops,
            targetYerSubUnits: requiredYerSubUnits,
            clearingWalletTarget: BIGISH_YER_WALLET
        };

    } catch (error) {
        console.error("[Cobra-Liquidity Critical Failure]:", error.message);
        return { success: false, reason: error.message };
    }
}

module.exports = { fetchInitialDexLiquidity };
